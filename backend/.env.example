# EventHub Backend Environment Configuration
PROJECT_NAME="EventHub API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration (placeholders only - no actual secrets)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="eventhub_db"

# Optional full database URL if using single string
# DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/eventhub_db"
